# CareerPilot environment variables
# Copy this file to .env and fill in real values.

# Server
PORT=4000
NODE_ENV=development

# Database
# MongoDB is required for resume, job, and auth features.
MONGO_URI=mongodb://127.0.0.1:27017/careerpilot
# Alternate name supported by the app if you prefer it.
# MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot

# Security
JWT_ACCESS_SECRET=generate-a-64-char-random-string
JWT_REFRESH_SECRET=generate-a-different-64-char-random-string
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# Frontend / CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:4000

# Redis
# Set this to your remote Redis provider URL (for example Upstash or Redis Cloud).
REDIS_URL=redis://your-remote-redis-host:6379

# External APIs
JSEARCH_API_KEY=replace-with-your-rapidapi-key
HUGGINGFACE_API_KEY=replace-with-your-hugging-face-api-key

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/oauth/google/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/oauth/github/callback

# Payment
PAYSTACK_SECRET_KEY=sk_test_c89db9f68ef3522a82ce9dc328dc8480d99a9089
PAYSTACK_PUBLIC_KEY=pk_test_19ad60829d105d5348cf219b12ade540ca3b92ad
# Where the user's browser is redirected after PayStack checkout.
# Localhost is fine here — the redirect happens client-side.
PAYSTACK_CALLBACK_URL=http://localhost:4000/api/payments/verify
# Premium amounts in kobo (PayStack's smallest currency unit)
PREMIUM_MONTHLY_KOBO=1900000
PREMIUM_ANNUAL_KOBO=18000000

# ╔══════════════════════════════════════════════════════════════╗
# ║  SECURITY NOTICE — NEVER COMMIT .env TO VERSION CONTROL    ║
# ╚══════════════════════════════════════════════════════════════╝
# The production .env must be loaded via AWS Secrets Manager or Parameter Store.
# This .env.example file is for documentation purposes only.
# See docs/refactoring/00-emergency-response.md for incident details.
