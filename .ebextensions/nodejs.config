option_settings:
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 8080
    # Set ALL secrets via AWS Console → Configuration → Software → Environment Properties
    # NEVER ship .env or secrets in source control
    # See docs/refactoring/00-emergency-response.md
