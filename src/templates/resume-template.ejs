<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= data.name || 'Professional' %> Resume</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        @page { margin: 0; size: A4; }

        :root {
            --paper: #fcfbf9;
            --ink: #1c1a17;
            --muted: #6b6459;
            --line: #e4ded3;
            --accent: #a9793f;
            --accent-soft: #efe4d2;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            line-height: 1.6;
            color: var(--ink);
            background: #ded9cf;
        }

        .resume-container {
            width: 210mm;
            min-height: 297mm;
            background: var(--paper);
            margin: 0 auto;
            padding: 20mm 18mm 16mm;
        }

        /* ---------- Header ---------- */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            padding-bottom: 18px;
            border-bottom: 1.5px solid var(--ink);
            margin-bottom: 26px;
        }
        .identity h1 {
            font-family: 'Cormorant Garamond', serif;
            font-weight: 600;
            font-size: 40px;
            letter-spacing: 0.2px;
            color: var(--ink);
        }
        .identity .title {
            margin-top: 4px;
            font-size: 14px;
            font-weight: 500;
            color: var(--accent);
            letter-spacing: 0.3px;
        }
        .contact-block {
            text-align: right;
            font-size: 11px;
            color: var(--muted);
        }
        .contact-block .contact-line {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
            margin-bottom: 5px;
        }
        .contact-block .contact-line:last-child { margin-bottom: 0; }
        .contact-block svg { width: 12px; height: 12px; stroke: var(--accent); flex-shrink: 0; }

        /* ---------- Sections ---------- */
        .section { margin-bottom: 22px; }
        .section:last-child { margin-bottom: 0; }

        .section-title {
            font-family: 'DM Sans', sans-serif;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            color: var(--ink);
            padding-bottom: 6px;
            border-bottom: 1px solid var(--line);
            margin-bottom: 14px;
        }

        .summary-text {
            font-family: 'Cormorant Garamond', serif;
            font-size: 16.5px;
            font-style: italic;
            line-height: 1.65;
            color: #383430;
            max-width: 92%;
        }

        /* ---------- Experience ---------- */
        .entry { margin-bottom: 16px; }
        .entry:last-child { margin-bottom: 0; }
        .entry-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 12px;
        }
        .entry-role {
            font-size: 14px;
            font-weight: 700;
            color: var(--ink);
        }
        .entry-org {
            font-size: 13px;
            font-weight: 500;
            color: var(--accent);
        }
        .entry-meta {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            color: var(--muted);
            white-space: nowrap;
            text-align: right;
        }
        .entry-body {
            margin-top: 5px;
            font-size: 12.5px;
            color: #3d3934;
            line-height: 1.6;
            max-width: 96%;
        }
        .entry-contact {
            margin-top: 4px;
            font-size: 10.5px;
            color: var(--muted);
        }

        /* ---------- Two-column blocks (education / projects / certs) ---------- */
        .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px 24px;
        }
        .block-item {
            padding-left: 12px;
            border-left: 2px solid var(--line);
        }
        .block-title { font-size: 13px; font-weight: 600; color: var(--ink); }
        .block-sub { font-size: 12px; color: var(--accent); margin-top: 1px; }
        .block-meta {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            color: var(--muted);
            margin-top: 2px;
        }
        .block-desc { font-size: 12px; color: #3d3934; margin-top: 4px; line-height: 1.55; }

        /* ---------- Skills ---------- */
        .skills-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 10px;
        }
        .skill-chip {
            font-size: 11px;
            font-weight: 500;
            color: var(--ink);
            background: var(--accent-soft);
            border: 1px solid var(--line);
            border-radius: 3px;
            padding: 4px 10px;
        }

        /* ---------- Achievements ---------- */
        .achievement-list { list-style: none; }
        .achievement-list li {
            position: relative;
            padding-left: 14px;
            margin-bottom: 6px;
            font-size: 12.5px;
            color: #3d3934;
            line-height: 1.55;
        }
        .achievement-list li:last-child { margin-bottom: 0; }
        .achievement-list li::before {
            content: '';
            position: absolute;
            left: 0;
            top: 7px;
            width: 4px;
            height: 4px;
            background: var(--accent);
        }

        .footer-note {
            margin-top: 22px;
            padding-top: 10px;
            border-top: 1px solid var(--line);
            font-size: 9px;
            color: #a39c8e;
            text-align: right;
        }

        @media print {
            body { background: var(--paper); -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
            .resume-container { box-shadow: none !important; }
        }
    </style>
</head>
<body>
    <div class="resume-container">

        <div class="header">
            <div class="identity">
                <h1><%= data.name || 'Your Name' %></h1>
                <% if (data.currentJobTitle) { %><div class="title"><%= data.currentJobTitle %></div><% } %>
            </div>
            <div class="contact-block">
                <% if (data.email) { %>
                <div class="contact-line"><span><%= data.email %></span><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M3 6h18v12H3z"/><path d="M3 7l9 6 9-6"/></svg></div>
                <% } %>
                <% if (data.phone) { %>
                <div class="contact-line"><span><%= data.phone %></span><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M6 3h4l1 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 1v4a2 2 0 0 1-2 2A16 16 0 0 1 4 5a2 2 0 0 1 2-2z"/></svg></div>
                <% } %>
                <% if (data.location) { %>
                <div class="contact-line"><span><%= data.location %></span><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><circle cx="12" cy="10" r="3"/><path d="M12 21s7-6.5 7-11a7 7 0 0 0-14 0c0 4.5 7 11 7 11z"/></svg></div>
                <% } %>
                <% if (data.linkedinUrl) { %>
                <div class="contact-line"><span>LinkedIn</span><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M4 4h16v16H4z"/><path d="M8 10v6M8 7v.01M12 16v-4a2 2 0 0 1 4 0v4M12 10v6"/></svg></div>
                <% } %>
                <% if (data.githubUrl) { %>
                <div class="contact-line"><span>GitHub</span><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M12 3a9 9 0 0 0-2.8 17.5c.4.1.6-.2.6-.4v-1.6c-2.5.5-3-1.1-3-1.1-.4-1-1-1.3-1-1.3-.8-.6.1-.6.1-.6.9.1 1.4.9 1.4.9.8 1.4 2.2 1 2.7.8.1-.6.3-1 .6-1.3-2-.2-4.1-1-4.1-4.5 0-1 .3-1.8 1-2.5-.1-.2-.4-1.2.1-2.5 0 0 .8-.3 2.7 1 .8-.2 1.6-.3 2.5-.3s1.7.1 2.5.3c1.9-1.3 2.7-1 2.7-1 .5 1.3.2 2.3.1 2.5.6.7 1 1.5 1 2.5 0 3.5-2.1 4.3-4.1 4.5.3.3.6.9.6 1.8v2.6c0 .2.2.5.6.4A9 9 0 0 0 12 3z"/></svg></div>
                <% } %>
                <% if (data.portfolioUrl) { %>
                <div class="contact-line"><span>Portfolio</span><svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg></div>
                <% } %>
            </div>
        </div>

        <% if (data.summary) { %>
        <div class="section">
            <div class="summary-text"><%= data.summary %></div>
        </div>
        <% } %>

        <% if (data.skills && data.skills.length > 0) { %>
        <div class="section">
            <div class="section-title">Core Skills</div>
            <div class="skills-row">
                <% data.skills.forEach(function(skill) { %>
                <span class="skill-chip"><%= skill %></span>
                <% }) %>
            </div>
        </div>
        <% } %>

        <% if (data.workExperience && data.workExperience.length > 0) { %>
        <div class="section">
            <div class="section-title">Experience</div>
            <% data.workExperience.forEach(function(job) { %>
            <div class="entry">
                <div class="entry-head">
                    <div>
                        <span class="entry-role"><%= typeof job === 'string' ? job : (job.position || job.title || '') %></span>
                        <% if (job.company) { %><span class="entry-org"> — <%= job.company %></span><% } %>
                    </div>
                    <% if (job.duration || job.location) { %>
                    <div class="entry-meta"><%= job.duration %><%= (job.duration && job.location) ? ' · ' : '' %><%= job.location %></div>
                    <% } %>
                </div>
                <% if (job.responsibilities || job.description) { %><div class="entry-body"><%= job.responsibilities || job.description %></div><% } %>
                <% if (job.contact) { %><div class="entry-contact">Reference: <%= job.contact %></div><% } %>
            </div>
            <% }) %>
        </div>
        <% } %>

        <% if (data.projects && data.projects.length > 0) { %>
        <div class="section">
            <div class="section-title">Projects</div>
            <div class="grid-2">
                <% data.projects.forEach(function(project) { %>
                <div class="block-item">
                    <div class="block-title"><%= typeof project === 'string' ? project : (project.name || '') %></div>
                    <% if (project.dates) { %><div class="block-meta"><%= project.dates %></div><% } %>
                    <% if (project.description) { %><div class="block-desc"><%= project.description %></div><% } %>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <% if (data.education && data.education.length > 0) { %>
        <div class="section">
            <div class="section-title">Education</div>
            <div class="grid-2">
                <% data.education.forEach(function(edu) { %>
                <div class="block-item">
                    <div class="block-title"><%= typeof edu === 'string' ? edu : (edu.degree || edu.institution || '') %></div>
                    <% if (edu.institution && edu.degree) { %><div class="block-sub"><%= edu.institution %></div><% } %>
                    <% if (edu.year || edu.location) { %><div class="block-meta"><%= edu.year %><%= (edu.year && edu.location) ? ' · ' : '' %><%= edu.location %></div><% } %>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <% if (data.certificates && data.certificates.length > 0) { %>
        <div class="section">
            <div class="section-title">Certificates</div>
            <div class="grid-2">
                <% data.certificates.forEach(function(cert) { %>
                <div class="block-item">
                    <div class="block-title"><%= typeof cert === 'string' ? cert : (cert.name || '') %></div>
                    <% if (cert.issuer) { %><div class="block-sub"><%= cert.issuer %></div><% } %>
                    <% if (cert.date) { %><div class="block-meta"><%= cert.date %></div><% } %>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>

        <% if (data.achievements && data.achievements.length > 0) { %>
        <div class="section">
            <div class="section-title">Achievements</div>
            <ul class="achievement-list">
                <% data.achievements.forEach(function(achievement) { %>
                <li><%= achievement %></li>
                <% }) %>
            </ul>
        </div>
        <% } %>

        <div class="footer-note">Prepared with CareerPilot</div>
    </div>
</body>
</html>
