{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-undef": "error",
    "prefer-const": "warn",
    "no-var": "warn",
    "eqeqeq": ["warn", "always"],
    "no-process-exit": "off",
    "no-prototype-builtins": "off",
    "no-empty": ["warn", { "allowEmptyCatch": true }]
  },
  "ignorePatterns": ["node_modules/", "frontend/", "public/", "coverage/", "load-tests/"]
}
